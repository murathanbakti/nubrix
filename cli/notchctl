#!/bin/bash
PATH=/usr/bin:/bin:/usr/sbin:/sbin; export PATH
dev="${NUBRIX_DEV:-}"
if [ "$dev" = 1 ]; then
  endpoint="${NUBRIX_ENDPOINT_FILE:-$HOME/.config/nubrix-run/agent-endpoint}"
else
  endpoint="$HOME/.config/nubrix-run/agent-endpoint"
fi

usage() {
  cat <<'USAGE'
Usage:
  notchctl notify <message> [--title T] [--style success|error|info|warning] [--duration N]
  notchctl ping
  notchctl --help

Commands:
  notify   Show a banner on the Nubrix notch and keep it in the Dev tab history.
  ping     Exit 0 if Nubrix is running and reachable, 1 otherwise.

Options for notify:
  --title T       Short title (max 80 characters).
  --style S       success, error, info (default) or warning.
  --duration N    Seconds to show the banner, 1-30 (default 4).

Environment:
  NUBRIX_DEV=1           Tests only: honour NUBRIX_ENDPOINT_FILE (default ~/.config/nubrix-run/agent-endpoint),
                         skip the owner, mode and process checks, accept a file without a process id.
USAGE
}

fail() {
  echo "notchctl: $*" >&2
  exit 1
}

json_escape() {
  local s=$1 out="" ch i code
  LC_ALL=C
  for ((i = 0; i < ${#s}; i++)); do
    ch=${s:i:1}
    case "$ch" in
      '"') out+='\"' ;;
      '\') out+='\\' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      $'\b') out+='\b' ;;
      $'\f') out+='\f' ;;
      *)
        printf -v code '%d' "'$ch"
        if [ "$code" -ge 0 ] && [ "$code" -lt 32 ]; then
          printf -v ch '\\u%04x' "$code"
        fi
        out+=$ch
        ;;
    esac
  done
  printf '%s' "$out"
}

verify_pid() {
  local info uid comm
  info="$(/bin/ps -o uid=,comm= -p "$1" 2>/dev/null)" || return 1
  case "$info" in ''|*$'\n'*) return 1 ;; esac
  info="${info#"${info%%[![:space:]]*}"}"
  uid="${info%%[[:space:]]*}"
  comm="${info#*[[:space:]]}"
  comm="${comm#"${comm%%[![:space:]]*}"}"
  [ "$uid" = "$UID" ] || return 1
  case "$comm" in */Nubrix.app/Contents/MacOS/Nubrix) return 0 ;; esac
  return 1
}

load_endpoint() {
  [ -r "$endpoint" ] || fail "Nubrix is not running (no endpoint file at $endpoint)"
  if [ "$dev" != 1 ]; then
    [ "$(/usr/bin/stat -f '%u %Lp' "$endpoint" 2>/dev/null)" = "$UID 600" ] || fail "endpoint file $endpoint has the wrong owner or mode"
  fi
  read -r port token pid < "$endpoint" || [ -n "$port" ]
  case "$port" in
    ''|*[!0-9]*) fail "endpoint file $endpoint is malformed" ;;
  esac
  case "$token" in
    ''|*[!0-9a-f]*) fail "endpoint file $endpoint is malformed" ;;
  esac
  [ "${#token}" -eq 64 ] || fail "endpoint file $endpoint is malformed"
  case "$pid" in
    '') [ "$dev" = 1 ] || fail "endpoint file $endpoint is outdated (restart Nubrix)" ;;
    *[!0-9]*) fail "endpoint file $endpoint is malformed" ;;
    *)
      kill -0 "$pid" 2>/dev/null || fail "Nubrix is not running (stale endpoint file)"
      if [ "$dev" != 1 ]; then
        verify_pid "$pid" || fail "endpoint file $endpoint does not belong to a running Nubrix"
      fi
      ;;
  esac
}

request() {
  local method=$1 path=$2 body=${3-}
  local args=(--silent --output /dev/null --write-out '%{http_code}' --max-time 2 -X "$method")
  if [ -n "$body" ]; then
    status=$(printf '%s' "$body" | /usr/bin/curl "${args[@]}" \
      -H @<(printf 'Authorization: Bearer %s\n' "$token") \
      -H "Content-Type: application/json" --data-binary @- \
      "http://127.0.0.1:$port$path") || status=000
  else
    status=$(/usr/bin/curl "${args[@]}" \
      -H @<(printf 'Authorization: Bearer %s\n' "$token") \
      "http://127.0.0.1:$port$path") || status=000
  fi
}

cmd_notify() {
  local message="" title="" style="" duration="" have_message=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --title) [ $# -ge 2 ] || fail "--title needs a value"; title=$2; shift 2 ;;
      --style) [ $# -ge 2 ] || fail "--style needs a value"; style=$2; shift 2 ;;
      --duration) [ $# -ge 2 ] || fail "--duration needs a value"; duration=$2; shift 2 ;;
      --title=*) title=${1#*=}; shift ;;
      --style=*) style=${1#*=}; shift ;;
      --duration=*) duration=${1#*=}; shift ;;
      -h|--help) usage; exit 0 ;;
      --) shift; if [ $# -gt 0 ]; then message=$1; have_message=1; shift; fi ;;
      -*) fail "unknown option $1" ;;
      *)
        [ "$have_message" -eq 0 ] || fail "unexpected argument '$1' (quote the message)"
        message=$1; have_message=1; shift ;;
    esac
  done
  [ "$have_message" -eq 1 ] && [ -n "$message" ] || fail "missing message (notchctl notify <message>)"
  case "$style" in
    ''|success|error|info|warning) ;;
    *) fail "invalid style '$style' (success, error, info, warning)" ;;
  esac
  case "$duration" in
    '') ;;
    *[!0-9.]*|.*|*.|*.*.*) fail "invalid duration '$duration'" ;;
    *) duration="$((10#${duration%%.*}))${duration#"${duration%%.*}"}" ;;
  esac

  local body
  body="{\"message\":\"$(json_escape "$message")\""
  [ -z "$title" ] || body+=",\"title\":\"$(json_escape "$title")\""
  [ -z "$style" ] || body+=",\"style\":\"$style\""
  [ -z "$duration" ] || body+=",\"duration\":$duration"
  body+="}"

  load_endpoint
  request POST /v1/notify "$body"
  case "$status" in
    204) exit 0 ;;
    000) fail "could not reach Nubrix (is it running?)" ;;
    401|404) fail "Nubrix rejected the request (stale token or endpoint; restart Nubrix or retry)" ;;
    400|422) fail "Nubrix rejected the notification (message max 500 characters, title max 80)" ;;
    *) fail "unexpected response from Nubrix (HTTP $status)" ;;
  esac
}

cmd_ping() {
  load_endpoint
  request GET /v1/ping
  [ "$status" = "204" ] || fail "Nubrix did not respond (HTTP $status)"
  exit 0
}

case "${1-}" in
  notify) shift; cmd_notify "$@" ;;
  ping) cmd_ping ;;
  -h|--help|help) usage ;;
  '') usage >&2; exit 2 ;;
  *) echo "notchctl: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
