#!/bin/bash
PATH=/usr/bin:/bin:/usr/sbin:/sbin; export PATH
export LC_ALL=C
dev=""
if [ "${NUBRIX_DEV:-}" = 1 ]; then
  nubrix_src="${BASH_SOURCE[0]:-$0}"
  case "$nubrix_src" in */*) ;; *) nubrix_src="./$nubrix_src" ;; esac
  nubrix_hops=0
  while [ -L "$nubrix_src" ] && [ "$nubrix_hops" -lt 8 ]; do
    nubrix_link="$(/usr/bin/readlink "$nubrix_src" 2>/dev/null)" || break
    case "$nubrix_link" in /*) nubrix_src="$nubrix_link" ;; *) nubrix_src="${nubrix_src%/*}/$nubrix_link" ;; esac
    nubrix_hops=$((nubrix_hops + 1))
  done
  nubrix_src_dir="$(cd "${nubrix_src%/*}" 2>/dev/null && pwd -P)"
  nubrix_sealed_dir="$(cd "$HOME/.config/nubrix/bin" 2>/dev/null && pwd -P)"
  if [ -n "$nubrix_src_dir" ] && [ "$nubrix_src_dir" != "$nubrix_sealed_dir" ] && [ ! -L "$nubrix_src" ]; then
    dev=1
  fi
fi
if [ "$dev" = 1 ]; then
  endpoint="${NUBRIX_ENDPOINT_FILE:-$HOME/.config/nubrix-run/agent-endpoint}"
else
  endpoint="$HOME/.config/nubrix-run/agent-endpoint"
fi

nubrix_verify_pid() {
  local info uid comm
  info="$(/bin/ps -o uid=,comm= -p "$1" 2>/dev/null)" || return 1
  case "$info" in ''|*$'\n'*) return 1 ;; esac
  info="${info#"${info%%[![:space:]]*}"}"
  uid="${info%%[[:space:]]*}"
  comm="${info#*[[:space:]]}"
  comm="${comm#"${comm%%[![:space:]]*}"}"
  [ "$uid" = "$UID" ] || return 1
  case "$comm" in */Nubrix.app/Contents/MacOS/Nubrix) return 0 ;; esac
  return 1
}

nubrix_load_endpoint() {
  [ -r "$endpoint" ] || return 1
  if [ "$dev" != 1 ]; then
    [ "$(/usr/bin/stat -f '%u %Lp' "$endpoint" 2>/dev/null)" = "$UID 600" ] || return 1
  fi
  read -r port token pid < "$endpoint" || [ -n "$port" ]
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  case "$token" in ''|*[!0-9a-f]*) return 1 ;; esac
  [ "${#token}" -eq 64 ] || return 1
  if [ -n "$pid" ] || [ "$dev" != 1 ]; then
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
  fi
  if [ "$dev" != 1 ]; then
    nubrix_verify_pid "$pid" || return 1
  fi
  return 0
}

nubrix_clean() {
  printf '%s' "$1" | /usr/bin/tr -cd 'A-Za-z0-9._:+@/# -' | /usr/bin/cut -c1-"${2:-100}"
}

nubrix_json_string() {
  local rest="${2#*\"$1\"}"
  [ "$rest" = "$2" ] && return 0
  printf '%s' "$rest" | /usr/bin/sed -n 's/^[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' | /usr/bin/head -n 1
}

nubrix_source_args() {
  source_args=()
  local entry app term host
  entry="$(nubrix_clean "${CLAUDE_CODE_ENTRYPOINT:-}" 48)"
  app="$(nubrix_clean "${__CFBundleIdentifier:-}" 128)"
  term="$(nubrix_clean "${TERM_PROGRAM:-}" 48)"
  [ -n "$entry" ] && source_args+=(-H "X-Nubrix-Entrypoint: $entry")
  [ -n "$app" ] && source_args+=(-H "X-Nubrix-App: $app")
  [ -n "$term" ] && source_args+=(-H "X-Nubrix-Term: $term")
  host="${CLAUDE_CODE_HOST_SESSION_ID:-}"
  if [[ "$host" =~ ^local_[A-Za-z0-9-]{1,64}$ ]]; then
    source_args+=(-H "X-Nubrix-Host-Session: $host")
  fi
  return 0
}

nubrix_hmac() {
  local key="$1" msg="$2" i b t ipad="" opad=""
  case "$key" in ''|*[!0-9a-f]*) return 1 ;; esac
  [ "${#key}" -le 128 ] || return 1
  while [ "${#key}" -lt 128 ]; do key="${key}00"; done
  for ((i = 0; i < 128; i += 2)); do
    b=$((16#${key:i:2}))
    printf -v t '\\x%02x' $((b ^ 0x36)); ipad+=$t
    printf -v t '\\x%02x' $((b ^ 0x5c)); opad+=$t
  done
  {
    printf "$opad"
    { printf "$ipad"; printf '%s' "$msg"; } | /usr/bin/openssl dgst -sha256 -binary
  } | /usr/bin/openssl dgst -sha256 | /usr/bin/sed 's/^.*= *//'
}

nubrix_listener_pid() {
  local out lp wd result=""
  out="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/nubrix-lsof.XXXXXX" 2>/dev/null)" || return 1
  /usr/sbin/lsof -nP -a -p "$pid" -iTCP@127.0.0.1:"$port" -sTCP:LISTEN -t >"$out" 2>/dev/null </dev/null &
  lp=$!
  ( /bin/sleep 1; kill -9 "$lp" ) >/dev/null 2>&1 </dev/null &
  wd=$!
  if wait "$lp" 2>/dev/null; then result="$(<"$out")"; fi
  kill "$wd" 2>/dev/null
  wait "$wd" 2>/dev/null
  /bin/rm -f "$out"
  printf '%s' "$result"
}

nubrix_load_endpoint || exit 0

if [ "$dev" != 1 ]; then
  [ "$(nubrix_listener_pid)" = "$pid" ] || exit 0
fi

body="$(/usr/bin/head -c 65537)"
/bin/cat >/dev/null
[ "${#body}" -le 65536 ] || exit 0
session="$(nubrix_json_string session_id "$body")"
[ -n "$session" ] || exit 0
case "$(nubrix_json_string tool_name "$body")" in
  AskUserQuestion|ExitPlanMode) exit 0 ;;
esac

case "${CLAUDE_CODE_ENTRYPOINT:-}" in
  claude-desktop|claude-vscode|sdk-*) wait=110 ;;
  *) wait=12 ;;
esac
if [ "$dev" = 1 ]; then
  case "${NUBRIX_PERMISSION_WAIT:-}" in
    ''|*[!0-9]*) ;;
    *) wait="$NUBRIX_PERMISSION_WAIT" ;;
  esac
fi

base="http://127.0.0.1:$port"

probe="$(/usr/bin/curl --silent --output /dev/null --write-out '%{http_code}' --max-time 1 --connect-timeout 1 \
  -H @<(printf 'Authorization: Bearer %s\n' "$token") \
  "$base/v1/ping" 2>/dev/null)"
[ "$probe" = "204" ] || exit 0

nonce="$(/usr/bin/openssl rand -hex 16 2>/dev/null)"
case "$nonce" in ''|*[!0-9a-f]*) exit 0 ;; esac
[ "${#nonce}" -eq 32 ] || exit 0

nubrix_source_args

answer="$(printf '%s' "$body" | /usr/bin/curl --silent --fail --max-time "$wait" --connect-timeout 1 \
  -H @<(printf 'Authorization: Bearer %s\n' "$token") \
  -H "Content-Type: application/json" \
  -H "X-Nubrix-Wait: $wait" \
  -H "X-Nubrix-Nonce: $nonce" \
  "${source_args[@]}" \
  --data-binary @- \
  "$base/v1/claude/permission" 2>/dev/null)" || exit 0

decision=""
proof="$(printf '%s' "$answer" | /usr/bin/sed -n 's/^{"decision":"allow","proof":"\([0-9a-f]\{64\}\)"}$/\1/p')"
if [ -n "$proof" ]; then
  decision="allow"
else
  proof="$(printf '%s' "$answer" | /usr/bin/sed -n 's/^{"decision":"deny","message":"Denied from the Nubrix notch","proof":"\([0-9a-f]\{64\}\)"}$/\1/p')"
  [ -n "$proof" ] && decision="deny"
fi
[ -n "$decision" ] || exit 0

expected="$(nubrix_hmac "$token" "$nonce|$decision|$session")"
[ -n "$expected" ] && [ "$expected" = "$proof" ] || exit 0

case "$decision" in
  allow)
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"allow"}}}'
    ;;
  deny)
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"PermissionRequest","decision":{"behavior":"deny","message":"Denied from the Nubrix notch"}}}'
    ;;
esac

exit 0
