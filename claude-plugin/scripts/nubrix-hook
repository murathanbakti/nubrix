#!/bin/bash
PATH=/usr/bin:/bin:/usr/sbin:/sbin; export PATH
export LC_ALL=C
dev=""
if [ "${NUBRIX_DEV:-}" = 1 ]; then
  nubrix_src="${BASH_SOURCE[0]:-$0}"
  case "$nubrix_src" in */*) ;; *) nubrix_src="./$nubrix_src" ;; esac
  nubrix_hops=0
  while [ -L "$nubrix_src" ] && [ "$nubrix_hops" -lt 8 ]; do
    nubrix_link="$(/usr/bin/readlink "$nubrix_src" 2>/dev/null)" || break
    case "$nubrix_link" in /*) nubrix_src="$nubrix_link" ;; *) nubrix_src="${nubrix_src%/*}/$nubrix_link" ;; esac
    nubrix_hops=$((nubrix_hops + 1))
  done
  nubrix_src_dir="$(cd "${nubrix_src%/*}" 2>/dev/null && pwd -P)"
  nubrix_sealed_dir="$(cd "$HOME/.config/nubrix/bin" 2>/dev/null && pwd -P)"
  if [ -n "$nubrix_src_dir" ] && [ "$nubrix_src_dir" != "$nubrix_sealed_dir" ] && [ ! -L "$nubrix_src" ]; then
    dev=1
  fi
fi
if [ "$dev" = 1 ]; then
  endpoint="${NUBRIX_ENDPOINT_FILE:-$HOME/.config/nubrix-run/agent-endpoint}"
else
  endpoint="$HOME/.config/nubrix-run/agent-endpoint"
fi

nubrix_verify_pid() {
  local info uid comm
  info="$(/bin/ps -o uid=,comm= -p "$1" 2>/dev/null)" || return 1
  case "$info" in ''|*$'\n'*) return 1 ;; esac
  info="${info#"${info%%[![:space:]]*}"}"
  uid="${info%%[[:space:]]*}"
  comm="${info#*[[:space:]]}"
  comm="${comm#"${comm%%[![:space:]]*}"}"
  [ "$uid" = "$UID" ] || return 1
  case "$comm" in */Nubrix.app/Contents/MacOS/Nubrix) return 0 ;; esac
  return 1
}

nubrix_load_endpoint() {
  [ -r "$endpoint" ] || return 1
  if [ "$dev" != 1 ]; then
    [ "$(/usr/bin/stat -f '%u %Lp' "$endpoint" 2>/dev/null)" = "$UID 600" ] || return 1
  fi
  read -r port token pid < "$endpoint" || [ -n "$port" ]
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  case "$token" in ''|*[!0-9a-f]*) return 1 ;; esac
  [ "${#token}" -eq 64 ] || return 1
  if [ -n "$pid" ] || [ "$dev" != 1 ]; then
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
  fi
  if [ "$dev" != 1 ]; then
    nubrix_verify_pid "$pid" || return 1
  fi
  return 0
}

if ! nubrix_load_endpoint; then
  cat >/dev/null
  exit 0
fi

nubrix_clean() {
  printf '%s' "$1" | tr -cd 'A-Za-z0-9._:+@/# -' | cut -c1-"${2:-100}"
}

nubrix_json_string() {
  local rest="${2#*\"$1\"}"
  [ "$rest" = "$2" ] && return 0
  printf '%s' "$rest" | sed -n 's/^[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' | head -n 1
}

nubrix_branch() {
  local dir="$1"
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  GIT_OPTIONAL_LOCKS=0 git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null | head -n 1
}

nubrix_parse_remote() {
  local url="$1" host path owner repo rest auth
  case "$url" in
    https://*)
      rest="${url#https://}"
      auth="${rest%%/*}"
      [ "$auth" != "$rest" ] || return 0
      host="${auth##*@}"
      path="${rest#*/}"
      ;;
    ssh://*)
      rest="${url#ssh://}"
      auth="${rest%%/*}"
      [ "$auth" != "$rest" ] || return 0
      host="${auth##*@}"
      path="${rest#*/}"
      ;;
    *@*:*)
      auth="${url%%:*}"
      host="${auth##*@}"
      path="${url#*:}"
      case "${auth%@*}" in */*|'') return 0 ;; esac
      ;;
    *) return 0 ;;
  esac
  [ "$(printf '%s' "$host" | tr 'A-Z' 'a-z')" = "github.com" ] || return 0
  path="${path%/}"
  path="${path%.git}"
  owner="${path%%/*}"
  repo="${path#*/}"
  [ "$owner/$repo" = "$path" ] || return 0
  case "$repo" in */*|.|..) return 0 ;; esac
  [ "${#owner}" -ge 1 ] && [ "${#owner}" -le 39 ] && [ "${#repo}" -ge 1 ] && [ "${#repo}" -le 100 ] || return 0
  [[ "$owner" =~ ^[A-Za-z0-9][A-Za-z0-9-]*$ ]] || return 0
  [[ "$repo" =~ ^[A-Za-z0-9._-]+$ ]] || return 0
  printf '%s/%s' "$owner" "$repo"
}

nubrix_remote() {
  local dir="$1"
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  nubrix_parse_remote "$(GIT_OPTIONAL_LOCKS=0 git -C "$dir" remote get-url origin 2>/dev/null | head -n 1)"
}

nubrix_source_args() {
  source_args=()
  local entry app term host
  entry="$(nubrix_clean "${CLAUDE_CODE_ENTRYPOINT:-}" 48)"
  app="$(nubrix_clean "${__CFBundleIdentifier:-}" 128)"
  term="$(nubrix_clean "${TERM_PROGRAM:-}" 48)"
  [ -n "$entry" ] && source_args+=(-H "X-Nubrix-Entrypoint: $entry")
  [ -n "$app" ] && source_args+=(-H "X-Nubrix-App: $app")
  [ -n "$term" ] && source_args+=(-H "X-Nubrix-Term: $term")
  host="${CLAUDE_CODE_HOST_SESSION_ID:-}"
  if [[ "$host" =~ ^local_[A-Za-z0-9-]{1,64}$ ]]; then
    source_args+=(-H "X-Nubrix-Host-Session: $host")
  fi
  return 0
}

jq_bin=""
for candidate in /usr/bin/jq /opt/homebrew/bin/jq /usr/local/bin/jq; do
  if [ -x "$candidate" ]; then jq_bin="$candidate"; break; fi
done

filter='def cap($n): if type == "string" and length > $n then .[0:$n] else . end;
{
  hook_event_name, session_id, cwd, tool_name, notification_type,
  message: (.message | cap(2000)),
  prompt: (.prompt | cap(2000)),
  last_assistant_message: (.last_assistant_message | cap(2000)),
  tool_input: (if (.tool_input | type) == "object" then (.tool_input | walk(cap(8192))) else null end),
  transcript_path: (if (.hook_event_name == "Stop" or .hook_event_name == "SubagentStop") and (.transcript_path | type) == "string" then .transcript_path else null end)
} | with_entries(select(.value != null))'

usage_filter='def n: if type == "number" and . >= 0 and . < 1e12 then floor else 0 end;
def id: tostring | gsub("[^A-Za-z0-9._:+\\[\\]-]"; "") | .[0:64];
def prompt: .type == "user" and (.isSidechain != true) and (.isMeta != true) and (.isCompactSummary != true)
  and ((.message.content | type) == "string"
       or ((.message.content | type) == "array" and any(.message.content[]?; .type != "tool_result")));
def has_usage: .type == "assistant" and ((.message.usage | type) == "object") and .message.model != "<synthetic>";
def ctx: (.message.usage.input_tokens | n) + (.message.usage.cache_creation_input_tokens | n) + (.message.usage.cache_read_input_tokens | n);
[inputs | fromjson? | select(type == "object")] as $e
| ([$e | to_entries[] | select(.value | prompt) | .key] | last) as $p
| ([$e[] | select(has_usage and .isSidechain != true)] | last) as $last
| if $last == null then empty else
  ({contextTokens: ($last | ctx), model: ($last.message.model | id)}
   + (if $p == null then {} else
      ([$e[$p + 1:][] | select(has_usage)] | reduce .[] as $x ({}; .[($x.message.id // $x.uuid // "") | id] = $x.message.usage) | [.[]]) as $u
      | if ($u | length) == 0 then {} else
        {turnInput: ([$u[] | .input_tokens | n] | add),
         turnOutput: ([$u[] | .output_tokens | n] | add),
         turnCacheRead: ([$u[] | .cache_read_input_tokens | n] | add),
         turnCacheWrite: ([$u[] | .cache_creation_input_tokens | n] | add),
         messageId: ([$e[$p + 1:][] | select(has_usage)] | last | .message.id | id)}
        end
      end))
  end'

nubrix_skip() {
  local size
  size="$(/usr/bin/stat -f '%z' "$1" 2>/dev/null)" || size=0
  case "$size" in ''|*[!0-9]*) size=0 ;; esac
  if [ "$size" -gt "$2" ]; then echo $(( (size - $2) / 65536 )); else echo 0; fi
}

nubrix_usage() {
  [ -n "$jq_bin" ] || return 0
  local path="$1" dir base root real window out
  case "$path" in /*.jsonl) ;; *) return 0 ;; esac
  [ ! -L "$path" ] && [ -f "$path" ] || return 0
  [ "$(/usr/bin/stat -f '%u' "$path" 2>/dev/null)" = "$UID" ] || return 0
  dir="$(cd "$(dirname "$path")" 2>/dev/null && pwd -P)" || return 0
  base="$(basename "$path")"
  root="$(cd "$HOME/.claude" 2>/dev/null && pwd -P)" || return 0
  case "$dir/" in "$root/"*) ;; *) return 0 ;; esac
  real="$dir/$base"
  [ ! -L "$real" ] || return 0
  for window in "6291456 400" "25165824 4000"; do
    set -- $window
    out="$(/bin/dd if="$real" bs=65536 iseek="$(nubrix_skip "$real" "$1")" 2>/dev/null | /usr/bin/grep -E '"type": *"(assistant|user)"' | /usr/bin/grep -Ev '"type": *"tool_result"' | /usr/bin/tail -n "$2" | "$jq_bin" -Rnc "$usage_filter" 2>/dev/null)" || out=""
    [ -n "$out" ] || return 0
    case "$out" in *'"turnInput"'*) printf '%s' "$out"; return 0 ;; esac
  done
  printf '%s' "$out"
}

if [ -n "$jq_bin" ]; then
  body="$("$jq_bin" -c "$filter" 2>/dev/null)" || body=""
else
  body="$(head -c 262145)"
  cat >/dev/null
  if [ "${#body}" -gt 262144 ]; then
    big_event="$(nubrix_json_string hook_event_name "$body")"
    big_session="$(nubrix_json_string session_id "$body")"
    big_cwd="$(nubrix_json_string cwd "$body")"
    big_tool="$(nubrix_json_string tool_name "$body")"
    body="{\"hook_event_name\":\"$big_event\",\"session_id\":\"$big_session\",\"cwd\":\"$big_cwd\""
    [ -n "$big_tool" ] && body="$body,\"tool_name\":\"$big_tool\""
    body="$body}"
  fi
fi
[ -n "$body" ] || exit 0

nubrix_source_args

event="$(nubrix_json_string hook_event_name "$body")"
case "$event" in
  SessionStart|UserPromptSubmit|Stop)
    work_dir="$(nubrix_json_string cwd "$body")"
    branch="$(nubrix_clean "$(nubrix_branch "$work_dir")" 100)"
    [ -n "$branch" ] && source_args+=(-H "X-Nubrix-Branch: $branch")
    remote="$(nubrix_remote "$work_dir")"
    [ -n "$remote" ] && source_args+=(-H "X-Nubrix-Remote: $remote")
    tty_name="$(/bin/ps -o tty= -p $$ 2>/dev/null | tr -d '[:space:]')"
    [[ "$tty_name" =~ ^ttys[0-9]{1,4}$ ]] || tty_name="$(/bin/ps -o tty= -p "$PPID" 2>/dev/null | tr -d '[:space:]')"
    if [[ "$tty_name" =~ ^ttys[0-9]{1,4}$ ]]; then
      source_args+=(-H "X-Nubrix-TTY: $tty_name")
    fi
    focus_url="${WARP_FOCUS_URL:-}"
    if [ "${#focus_url}" -le 64 ] && [[ "$focus_url" =~ ^warp[a-z]{0,12}://session/[0-9a-f]{32}$ ]]; then
      source_args+=(-H "X-Nubrix-Focus-URL: $focus_url")
    fi
    ;;
esac

case "$event" in
  Stop|SubagentStop)
    case "$body" in
      *',"transcript_path":"'*'"}')
        transcript="${body##*\"transcript_path\":\"}"
        transcript="${transcript%\"\}}"
        body="${body%,\"transcript_path\":\"*}"
        usage=""
        case "$transcript" in *\\*|*\"*) ;; *) usage="$(nubrix_usage "$transcript")" ;; esac
        if [ -n "$usage" ]; then body="$body,\"nubrix_usage\":$usage}"; else body="$body}"; fi
        ;;
    esac
    ;;
esac

printf '%s' "$body" | /usr/bin/curl --silent --output /dev/null --max-time 1 \
  -H @<(printf 'Authorization: Bearer %s\n' "$token") \
  -H "Content-Type: application/json" \
  "${source_args[@]}" \
  --data-binary @- \
  "http://127.0.0.1:$port/v1/claude/hook" || true

exit 0
