#!/bin/bash
PATH=/usr/bin:/bin:/usr/sbin:/sbin; export PATH
json="$(cat)"

nubrix_clean() {
  printf '%s' "$1" | LC_ALL=C tr -cd 'A-Za-z0-9._:+@/# -' | cut -c1-"${2:-100}"
}

nubrix_json_string() {
  local rest="${2#*\"$1\"}"
  [ "$rest" = "$2" ] && return 0
  printf '%s' "$rest" | sed -n 's/^[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' | head -n 1
}

nubrix_branch() {
  local dir="$1"
  [ -n "$dir" ] && [ -d "$dir" ] || return 0
  GIT_OPTIONAL_LOCKS=0 git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null | head -n 1
}

nubrix_source_args() {
  source_args=()
  local entry app term
  entry="$(nubrix_clean "${CLAUDE_CODE_ENTRYPOINT:-}" 48)"
  app="$(nubrix_clean "${__CFBundleIdentifier:-}" 128)"
  term="$(nubrix_clean "${TERM_PROGRAM:-}" 48)"
  [ -n "$entry" ] && source_args+=(-H "X-Nubrix-Entrypoint: $entry")
  [ -n "$app" ] && source_args+=(-H "X-Nubrix-App: $app")
  [ -n "$term" ] && source_args+=(-H "X-Nubrix-Term: $term")
  return 0
}

dev="${NUBRIX_DEV:-}"
if [ "$dev" = 1 ]; then
  endpoint="${NUBRIX_ENDPOINT_FILE:-$HOME/.config/nubrix-run/agent-endpoint}"
else
  endpoint="$HOME/.config/nubrix-run/agent-endpoint"
fi

nubrix_verify_pid() {
  local info uid comm
  info="$(/bin/ps -o uid=,comm= -p "$1" 2>/dev/null)" || return 1
  case "$info" in ''|*$'\n'*) return 1 ;; esac
  info="${info#"${info%%[![:space:]]*}"}"
  uid="${info%%[[:space:]]*}"
  comm="${info#*[[:space:]]}"
  comm="${comm#"${comm%%[![:space:]]*}"}"
  [ "$uid" = "$UID" ] || return 1
  case "$comm" in */Nubrix.app/Contents/MacOS/Nubrix) return 0 ;; esac
  return 1
}

nubrix_load_endpoint() {
  [ -r "$endpoint" ] || return 1
  if [ "$dev" != 1 ]; then
    [ "$(/usr/bin/stat -f '%u %Lp' "$endpoint" 2>/dev/null)" = "$UID 600" ] || return 1
  fi
  read -r port token pid < "$endpoint" || [ -n "$port" ]
  case "$port" in ''|*[!0-9]*) return 1 ;; esac
  case "$token" in ''|*[!0-9a-f]*) return 1 ;; esac
  [ "${#token}" -eq 64 ] || return 1
  if [ -n "$pid" ] || [ "$dev" != 1 ]; then
    case "$pid" in ''|*[!0-9]*) return 1 ;; esac
    kill -0 "$pid" 2>/dev/null || return 1
  fi
  if [ "$dev" != 1 ]; then
    nubrix_verify_pid "$pid" || return 1
  fi
  return 0
}

num() {
  local rest="${json#*\"$1\"}"
  [ "$rest" = "$json" ] && return 0
  printf '%s' "$rest" | sed -n 's/^[[:space:]]*:[[:space:]]*\(-\{0,1\}[0-9][0-9]*\(\.[0-9]*\)\{0,1\}\).*/\1/p' | head -n 1
}

str() {
  local rest="${json#*\"$1\"}"
  [ "$rest" = "$json" ] && return 0
  printf '%s' "$rest" | sed -n 's/^[[:space:]]*:[[:space:]]*"\([^"\\]*\)".*/\1/p' | head -n 1
}

jq_bin=""
for candidate in /usr/bin/jq /opt/homebrew/bin/jq /usr/local/bin/jq; do
  if [ -x "$candidate" ]; then jq_bin="$candidate"; break; fi
done

if [ -n "$jq_bin" ]; then
  fields="$(printf '%s' "$json" | "$jq_bin" -r '[(.workspace.current_dir // .cwd // ""), (.model.display_name // ""), (.context_window.used_percentage // "" | tostring), (.cost.total_cost_usd // "" | tostring)] | join("\u001f")' 2>/dev/null)"
  IFS=$'\037' read -r cwd model pct cost <<<"$fields"
else
  cwd="$(str current_dir)"
  [ -z "$cwd" ] && cwd="$(str cwd)"
  model="$(str display_name)"
  ctx="${json#*\"context_window\"}"
  pct="$(json="$ctx"; num used_percentage)"
  cost="$(num total_cost_usd)"
fi

branch=""
if [ -n "$cwd" ] && [ -d "$cwd" ]; then
  branch="$(GIT_OPTIONAL_LOCKS=0 git -C "$cwd" symbolic-ref --short -q HEAD 2>/dev/null | head -n 1)"
fi

if nubrix_load_endpoint; then
  nubrix_source_args
  clean_branch="$(nubrix_clean "$branch" 100)"
  [ -n "$clean_branch" ] && source_args+=(-H "X-Nubrix-Branch: $clean_branch")
  (
    /usr/bin/curl --silent --output /dev/null --max-time 1 \
      -H @<(printf 'Authorization: Bearer %s\n' "$token") \
      -H "Content-Type: application/json" \
      "${source_args[@]}" \
      --data-binary @- \
      "http://127.0.0.1:$port/v1/claude/status" <<<"$json" >/dev/null 2>&1 &
  ) >/dev/null 2>&1
fi

line="${cwd##*/}"
[ -n "$branch" ] && line="$line · $branch"
[ -n "$model" ] && line="$line · $model"
if [ -n "$pct" ]; then
  line="$line · ctx ${pct%%.*}%"
fi
if [ -n "$cost" ]; then
  line="$line · \$$(LC_ALL=C printf '%.2f' "$cost" 2>/dev/null)"
fi
line="$(printf '%s' "$line" | LC_ALL=C /usr/bin/tr -d '\000-\037\177' | LC_ALL=C /usr/bin/sed -e ':a' -e $'s/\xc2[\x80-\x9f]//' -e 'ta')"
printf '%s\n' "$line"
exit 0
